# =================================================================
# AccessReviewAgent - Environment Variables Configuration
# =================================================================

# -----------------
# Database (PostgreSQL)
# -----------------
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password

# -----------------
# Backend Authentication Tokens
# -----------------
# JSON mapping of device IDs to 32-byte secret tokens for agent telemetry ingestion
AGENT_TOKENS_JSON={"WIN-01":"REPLACE_WITH_AGENT_TOKEN_1","LNX-01":"REPLACE_WITH_AGENT_TOKEN_2"}

# Secret token required by the frontend/admin to view reports & summaries
ADMIN_API_TOKEN=replace_with_a_secure_admin_api_token

# -----------------
# Frontend Configuration
# -----------------
# The backend domain that frontend Nginx will proxy /api/admin/summary & /health to.
# (Without https:// or trailing slashes)
API_UPSTREAM=host.pasinduudana.me

# -----------------
# Ports (Optional overrides)
# -----------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

