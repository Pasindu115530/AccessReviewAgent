server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location = /health {
        limit_except GET { deny all; }
        proxy_pass https://${API_UPSTREAM}/health;
        proxy_set_header Host ${API_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        add_header Cache-Control 'no-store' always;
    }

    # Intentionally whitelist just this READ-only endpoint. Do not expose agent writes.
    location = /api/admin/summary {
        limit_except GET { deny all; }
        proxy_pass https://${API_UPSTREAM}/api/admin/summary;
        proxy_set_header Host ${API_UPSTREAM};
        proxy_set_header X-Admin-Token $http_x_admin_token;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 10s;
        proxy_read_timeout 20s;
        add_header Cache-Control 'no-store' always;
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
